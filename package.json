{
  "name": "kar-paid-on-proof",
  "version": "1.0.0",
  "description": "Fulfilment-gated settlement for AI agents on QDay Aevum testnet: ERC-8004 identity, a session-key smart account with caps, DocDec-verified deliverables, tUSD8 released only on proof.",
  "type": "module",
  "license": "MIT",
  "author": "Kar for AI Native Solutions",
  "homepage": "https://sjgant80-hub.github.io/kar-paid-on-proof/",
  "repository": {
    "type": "git",
    "url": "https://github.com/sjgant80-hub/kar-paid-on-proof"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./sdk/index.mjs",
    "./verify": "./sdk/verify.mjs",
    "./reader": "./sdk/reader.mjs",
    "./policy": "./sdk/policy.mjs",
    "./artifacts/*": "./artifacts/*"
  },
  "scripts": {
    "build": "node tools/compile.mjs",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "flow:local": "node flow.mjs --network local",
    "flow:aevum": "node flow.mjs --network aevum",
    "gate": "node tools/mutation-gate.mjs"
  },
  "dependencies": {
    "@ethereumjs/block": "5.3.0",
    "@ethereumjs/common": "4.4.0",
    "@ethereumjs/tx": "5.4.0",
    "@ethereumjs/util": "9.1.0",
    "@ethereumjs/vm": "8.1.1",
    "viem": "2.21.54"
  },
  "devDependencies": {
    "buffer": "6.0.3",
    "esbuild": "0.24.0",
    "events": "3.3.0",
    "solc": "0.8.24"
  }
}
